# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Database (Supabase Postgres). Local/CI can use the direct connection
# (db.xxxxxxxxxxxx.supabase.co:5432). On a host with no IPv6 egress (e.g.
# Render's default network) the direct host resolves IPv6-only and every
# query fails with ENETUNREACH — use the Session pooler connection string
# instead there (Supabase dashboard: Project Settings > Database >
# Connection Pooling > Session mode), which is IPv4.
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Auth — same project URL as the front's VITE_SUPABASE_URL.
# JWTs are verified via Supabase's public JWKS endpoint, no secret needed.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000